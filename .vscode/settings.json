{
  "[python]": {
    "editor.formatOnType": true,
    "editor.defaultFormatter": "ms-python.autopep8",
  },
  "autopep8.args": [
    "--max-line-length",
    "80",
    "--experimental",
    "--indent-size",
    "2",
  ],
  "editor.rulers": [80],
  "editor.tabSize": 2,
  "editor.indentSize": "tabSize",
  "python.analysis.typeCheckingMode": "basic",
}
